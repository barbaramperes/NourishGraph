# ============================================================
# NOURISHGRAPH - ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# ============================================================

# ============================================================
# REQUIRED - OpenAI
# ============================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here

# ============================================================
# REQUIRED - PostgreSQL Database
# ============================================================
# Recommended: Use Neon (https://neon.tech) - Free tier available
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://user:password@localhost:5432/nourishgraph

# ============================================================
# RECOMMENDED - Pinecone (Vector Database for RAG)
# ============================================================
# Get your API key from: https://www.pinecone.io
# Free tier: 1 index, 100k vectors
PINECONE_API_KEY=pcsk_your-api-key-here
PINECONE_INDEX_NAME=nutrisage-papers

# ============================================================
# OPTIONAL - USDA Food Database API
# ============================================================
# Get your API key from: https://fdc.nal.usda.gov/api-guide.html
# Free and unlimited
USDA_API_KEY=your-usda-api-key-here

# ============================================================
# OPTIONAL - RAG Configuration
# ============================================================
# Hybrid search weight: 0.0 = pure lexical, 1.0 = pure semantic
HYBRID_ALPHA=0.7

# HyDE (Hypothetical Document Embeddings) - experimental
HYDE_ENABLED=false

# Cross-encoder reranking for better precision
RERANK_ENABLED=true

# Google Colab GPU Server (fastest - FREE T4 GPU!)
# Run notebooks/colab_gpu_server.ipynb in Colab, then paste URL here
COLAB_GPU_URL=https://xxxx-xx-xxx-xxx-xxx.ngrok-free.app

# Cohere Rerank API (fallback if Colab unavailable)
# Get free API key: https://dashboard.cohere.com/
COHERE_API_KEY=your-cohere-api-key-here

# Time-weighted scoring (prefer recent papers)
TIME_WEIGHT_ENABLED=false

# ============================================================
# RECOMMENDED - Auth (keeps sessions valid across backend restarts)
# ============================================================
# Used to sign JWT access tokens. Set this to any long random string.
AUTH_SECRET_KEY=change-me-to-a-long-random-string
